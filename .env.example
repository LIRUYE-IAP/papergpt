# Local infrastructure
POSTGRES_DB=papergpt
POSTGRES_USER=papergpt
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql+psycopg://papergpt:replace-with-a-local-database-password@localhost:5432/papergpt
REDIS_URL=redis://localhost:6379/0

# Application
SECRET_KEY=replace-with-a-random-secret-in-local-env
STORAGE_ROOT=./storage

# Reserved for future provider integrations; leave blank in Phase 0.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
