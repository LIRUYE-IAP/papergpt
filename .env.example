# Local infrastructure
POSTGRES_DB=papergpt
POSTGRES_USER=papergpt
POSTGRES_PASSWORD=replace-with-a-local-database-password
DATABASE_URL=postgresql+psycopg://papergpt:replace-with-a-local-database-password@localhost:5432/papergpt
REDIS_URL=redis://localhost:6379/0

# Application
SECRET_KEY=replace-with-a-random-secret-in-local-env
STORAGE_ROOT=./storage
JWT_EXPIRATION_MINUTES=60
MAX_PDF_UPLOAD_MB=20
FRONTEND_ORIGIN=http://localhost:3000

# Phase 4A translation provider. Keep mock for local development and tests.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5-mini
TRANSLATION_BATCH_MAX_BLOCKS=6
TRANSLATION_BATCH_MAX_CHARS=15000

# Reserved for future provider integrations.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
